{
  "cli": {
    "version": ">= 14.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      },
      "autoIncrement": true
    },
    "production": {
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      },
      "autoIncrement": true,
      "android": {
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/release/mapping.txt"
        ]
      }
    }
  }
}
