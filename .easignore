# EAS uses this file instead of .gitignore when it exists, so it mirrors
# .gitignore and adds the local-only paths that must never be uploaded.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# env files
.env

# Launch-video renders from the brag skill
brag-output*/

# Local-only paths that must never enter an EAS build archive.
.agents/
.claude/
conversation-*.txt
