{
  "expo": {
    "name": "Fold",
    "slug": "Fold",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/fold-logo.png",
    "scheme": "fold",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fold.app"
    },
    "android": {
      "package": "com.fold.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/fold-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFB",
          "image": "./assets/fold-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fold to access your camera to capture memories.",
          "microphonePermission": "Allow Fold to access your microphone to record audio for memories."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Fold to save memories to your photos.",
          "savePhotosPermission": "Allow Fold to save memories to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-share-intent",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fold to use your location to automatically tag memories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.fold.app.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.fold.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3203950f-07bf-48c1-9153-218a1e05e23f"
      }
    },
    "owner": "vishnu_gupta_vg"
  }
}
