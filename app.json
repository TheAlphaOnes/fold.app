{
  "expo": {
    "name": "Fold",
    "slug": "Fold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fold-logo.png",
    "scheme": "fold",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF7",
        "foregroundImage": "./assets/fold-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/fold-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFB",
          "image": "./assets/fold-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fold to access your camera to capture memories.",
          "microphonePermission": "Allow Fold to access your microphone to record audio for memories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
